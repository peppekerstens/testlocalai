# Local-machine-specific access details for the remote worker host
# described in docs/REMOTE-WSL2-SETUP.md (generic write-up, no real
# values). Copy this file to .env (gitignored, never committed) and
# fill in your own — see that doc for what each path/port means.

REMOTE_WORKER_HOST=
REMOTE_WORKER_PORT_WSL=2222   # WSL2's own sshd, drops into bash
REMOTE_WORKER_PORT_WIN=22     # Windows-side sshd, drops into cmd.exe
REMOTE_WORKER_USER=
REMOTE_WORKER_SSH_KEY=~/.ssh/id_ed25519_remote-worker
