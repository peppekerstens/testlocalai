# dotnet build artifacts (task harnesses) — regenerable, machine-specific
bin/
obj/

# python build/test artifacts (task harnesses) — regenerable, machine-specific
__pycache__/
*.pyc
.pytest_cache/

# bench/pure-run.sh scratch output — freely overwritten, never evidence
# (see AGENTS.md "Reports are model-scoped; scratch files are not evidence")
bench/tmp/*
!bench/tmp/.gitkeep

# Claude Code / AI-tool runtime state — local session state, not project
# content, EXCEPT settings.json which is this project's own committed
# permission policy (see AGENTS.md "Unattended operation is authorized
# in this repo") — deliberately tracked, not local-only.
.claude/*
!.claude/settings.json

# session lifecycle state — runtime-created by session-start.sh, archived by session-stop.sh
bench/.session-state.json
bench/.session-state.json.last

# OS cruft
.DS_Store
Thumbs.db
